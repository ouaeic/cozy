{
  "name": "cozy",
  "version": "0.1.0",
  "description": "Watch things together, from far apart.",
  "license": "MIT",
  "author": "Cozy contributors",
  "homepage": "https://github.com/ouaeic/cozy#readme",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "server:dev": "node server/serve.mjs",
    "server:deploy": "wrangler deploy --config server/wrangler.toml",
    "test:call": "node test/call.test.mjs",
    "test:share": "node test/share.test.mjs",
    "test:audio": "node test/audio.test.mjs",
    "test:stereo": "node test/stereo.test.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test:group": "node test/group.test.mjs",
    "test:fullscreen": "node test/fullscreen.test.mjs",
    "test:clean": "pkill -f 'remote-debugging-port=9' || true; pkill -f 'cozy-test' || true; pkill -f 'getcozy_app/node_modules/electron/dist/Electron.app' || true; echo 'cleaned up any leftover test windows'",
    "test:bar": "node test/bar.test.mjs",
    "test:codes": "node test/codes.test.mjs",
    "test:inline": "node test/inline.test.mjs",
    "test:rejoin": "node test/rejoin.test.mjs",
    "test:hotstrip": "node test/hotstrip.test.mjs",
    "test": "node scripts/test-all.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@preact/signals": "^2.0.4",
    "@types/node": "^22.15.3",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^4.0.0",
    "preact": "^10.26.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "ws": "^8.18.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ouaeic/cozy.git"
  },
  "bugs": {
    "url": "https://github.com/ouaeic/cozy/issues"
  }
}
